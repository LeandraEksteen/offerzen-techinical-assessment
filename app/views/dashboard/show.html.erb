<h1>Dashboard</h1>
<p><%= link_to "Back to home", root_path %></p>

<% if @errors.present? %>
  <ul role="alert">
    <% @errors.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with url: dashboard_path, method: :get do |form| %>
  <p>
    <%= form.label :from, "From (assessment date)" %>
    <%= form.date_field :from, value: params[:from] %>
  </p>
  <p>
    <%= form.label :to, "To (assessment date)" %>
    <%= form.date_field :to, value: params[:to] %>
  </p>
  <p>
    <%= form.label :status, "Status" %>
    <%= form.select :status, @status_entries, { include_blank: "All", selected: params[:status] } %>
  </p>
  <%= form.submit "Filter" %>
<% end %>

<% if @assessments %>
  <% if @assessments.any? %>
    <p>Rows <%= (@page - 1) * DashboardController::PAGE_SIZE + 1 %> to <%= (@page - 1) * DashboardController::PAGE_SIZE + @assessments.size %></p>
  <% elsif @page > 1 %>
    <p>No assessments on this page.</p>
  <% else %>
    <p>No assessments.</p>
  <% end %>
  <table>
    <thead>
      <tr>
        <th>Employee email</th>
        <th>Employee id</th>
        <th>Assessment date</th>
        <th>Status</th>
        <th>Score</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @assessments.each do |assessment| %>
        <tr>
          <td><%= assessment.employee_for_listing.email %></td>
          <td><%= assessment.employee_id %></td>
          <td><%= assessment.assessment_date %></td>
          <td><%= assessment.status %></td>
          <td><%= displayed_score(assessment) %></td>
          <td><%= link_to "Edit status", edit_assessment_path(assessment) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <nav aria-label="Pages">
    Page <%= @page %>
    <% if @page > 1 %>
      <%= link_to "Previous", dashboard_page_path(@page - 1) %>
    <% end %>
    <% if @page > 2 || (@page > 1 && @assessments.empty?) %>
      <%= link_to "First page", dashboard_page_path(1) %>
    <% end %>
    <% if @has_next %>
      <%= link_to "Next", dashboard_page_path(@page + 1) %>
    <% end %>
  </nav>
<% end %>
